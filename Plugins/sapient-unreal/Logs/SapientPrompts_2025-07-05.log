```
function SetupTelekinesisInputs():
    // Check if input actions are assigned
    if not (IsValid(DefaultMappingContext) and IsValid(TelekinesisGrabAction) and 
            IsValid(TelekinesisAimAction) and IsValid(TelekinesisReleaseAction)):
        Print("Warning: Telekinesis input actions not fully assigned. Check BP_LianeCharacter properties.")
    
    // Create and setup HUD widget if it doesn't exist
    if not IsValid(TelekinesisHUDWidget):
        TelekinesisHUDWidget = CreateWidget(GetPlayerController(), WBP_TelekinesisHUD)
        TelekinesisHUDWidget.AddToViewport()
        TelekinesisHUDWidget.SetVisibility(ESlateVisibility.Collapsed)
    
    // Setup telekinesis component event bindings
    if IsValid(TelekinesisComponent):
        // Bind to OnObjectGrabbed event
        TelekinesisComponent.OnObjectGrabbed.AddDynamic(this, OnTelekinesisObjectGrabbed)
        
        // Bind to OnObjectReleased event
        TelekinesisComponent.OnObjectReleased.AddDynamic(this, OnTelekinesisObjectReleased)
        
        // Bind to OnObjectThrown event
        TelekinesisComponent.OnObjectThrown.AddDynamic(this, OnTelekinesisObjectThrown)
```

